# Project-local npm config.
#
# NOTE ON THE ENVIRONMENT BLOCKER:
# In the current environment NO npm registry is reachable:
#   - The machine's default private registry (http://registry.safaricomet.net)
#     does not resolve via DNS (you appear to be off the corporate network/VPN).
#   - The public registry (https://registry.npmjs.org) is reachable at the TCP
#     level but returns HTTP 403 for every package (blocked by a network policy /
#     TLS-inspecting proxy).
#
# To install dependencies, connect to the network where the internal registry
# resolves, then set it here, e.g.:
#   registry=http://registry.safaricomet.net/
#
# If that registry uses a TLS-inspecting proxy, you may also need the corporate
# root CA via the NODE_EXTRA_CA_CERTS env var (preferred over disabling TLS):
#   $env:NODE_EXTRA_CA_CERTS="C:\path\to\corp-root-ca.pem"
#
# Until a registry is reachable, `npm install` cannot fetch packages.

fund=false
audit=false
